namespace eval amba-fbd::vhdl-apb::static-0 {
  variable ctx [hbs::utils::ctxName [namespace current]]
  variable hdl [hbs::utils::hdlName [namespace current]]

  proc tb-python {} {
    variable ctx
    variable hdl
    set sw "python"

    hbs::utils::setupHdl $ctx $hdl $sw -add-timestamp
    hbs::utils::runPython $ctx $hdl $sw

    hbs::Run
  }

  proc tb-c-sync {} {
    variable ctx
    variable hdl
    set sw "c-sync"

    hbs::utils::setupHdl $ctx $hdl $sw -add-timestamp
    hbs::utils::compileAndRunC $ctx $hdl $sw

    hbs::Run
  }

  hbs::Register
}
