namespace eval utils {
  # ns is the namespace name from which hdl name will be extracted.
  proc hdlName {ns} {
    return [lindex [split $ns ::] end-2]
  }

  # ns is the namespace name from which hdl name will be extracted.
  proc ctxName {ns} {
    return [regsub {\-} [lindex [split $ns ::] end] /]
  }

  # args are extra arguments forwarded to the amba-fbd call.
  proc setupHdl {ctx hdl sw args} {
    hbs::SetTool "nvc"

    if {$hbs::Tool == "nvc"} {
      hbs::AddPostElabCb hbs::SetArgPrefix "--messages=compact"
      hbs::AddPostElabCb hbs::SetArgSuffix "--exit-severity=error --dump-arrays"
    }

    hbs::SetTop "tb_cosim"

    # JSON must belong to the same generation as the HDL and software.
    # This is particularly important for timestamp register tests.
    hbs::AddDep amba-fbd::gen \
      {*}$args \
      $hdl -path autogen/$ctx/tb-$sw \
      $sw -path autogen/$ctx/tb-$sw \
      json -path autogen/$ctx/$hdl/$sw \
      [hbs::ThisCoreDir]/../bus.fbd

    hbs::AddDep $hdl\::cosim::src
    hbs::AddFile *.vhd

    hbs::SetGeneric G_SW_GW_FIFO_PATH "/tmp/amba-fbd/$ctx/$sw-to-$hdl"
    hbs::SetGeneric G_GW_SW_FIFO_PATH "/tmp/amba-fbd/$ctx/$hdl-to-$sw"

    set logDir "/tmp/amba-fbd/$ctx/tb-$sw"
    if {[file exist $logDir] eq 0} {
      file mkdir $logDir
    }
  }

  proc runPython {ctx hdl sw} {
    set swGwFifo "/tmp/amba-fbd/$ctx/$sw-to-$hdl"
    set gwSwFifo "/tmp/amba-fbd/$ctx/$hdl-to-$sw"
    set logDir "/tmp/amba-fbd/$ctx/tb-$sw"
    set regJsonFile "../../../../../autogen/$ctx/$hdl/$sw/reg.json"
    set constJsonFile "../../../../../autogen/$ctx/$hdl/$sw/const.json"

    set pythonPaths "[pwd]/tests/co-simulations/common/python:[pwd]/autogen/$ctx/tb-$sw"
    if {[info exists env(PYTHONPATH)]} {
      set ::env(PYTHONPATH) $::env(PYTHONPATH):$pythonPaths
    } else {
      set ::env(PYTHONPATH) $pythonPaths
    }

    hbs::ExecInCoreDir "python3 ../$sw/tb.py \
      $swGwFifo $gwSwFifo \
      $regJsonFile $constJsonFile \
      > $logDir/$hdl.log &"
  }

  proc compileAndRunC {ctx hdl sw} {
    set dir autogen/$ctx/tb-$sw

    file copy -force {*}[glob tests/co-simulations/common/$sw/*] $dir
    file copy -force {*}[glob tests/co-simulations/$ctx/$sw/*] $dir

    set pwd [pwd]
    cd $dir

    exec gcc -Wall {*}[glob *.c] -o tb >@ stdout

    set swGwFifo "/tmp/amba-fbd/$ctx/$sw-to-$hdl"
    set gwSwFifo "/tmp/amba-fbd/$ctx/$hdl-to-$sw"
    set logDir "/tmp/amba-fbd/$ctx/tb-$sw"

    exec ./tb $swGwFifo $gwSwFifo > $logDir/$hdl.log &

    cd $pwd
  }
}
